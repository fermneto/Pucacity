{
  "name": "pucacity",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "shots": "node scripts/screenshots.mjs",
    "gen:demo": "node scripts/gen-demo-city.ts",
    "gen:vitrine": "node scripts/gen-vitrine.mjs",
    "e2e:ferramentas": "node scripts/e2e-ferramentas.mjs"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/varela-round": "^5.3.0",
    "lil-gui": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.15.0",
    "globals": "^15.15.0",
    "playwright": "^1.65.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
